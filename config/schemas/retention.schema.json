{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alex-taro.ru/schemas/retention.schema.json",
  "title": "Future Viewer retention policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manual_approved", "reviewed_at", "policies"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "manual_approved": { "type": "boolean" },
    "reviewed_at": { "type": ["string", "null"], "format": "date" },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "data_categories", "trigger", "retention_period", "legal_basis_reference", "deletion_mechanism", "backup_handling", "status", "manual_approved"],
        "properties": {
          "policy_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "data_categories": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "trigger": { "type": "string", "minLength": 1 },
          "retention_period": { "type": ["string", "null"] },
          "legal_basis_reference": { "type": ["string", "null"] },
          "deletion_mechanism": { "type": ["string", "null"] },
          "backup_handling": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["proposed", "blocked", "active", "expired"] },
          "manual_approved": { "type": "boolean" }
        }
      }
    }
  }
}
