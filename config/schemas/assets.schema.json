{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alex-taro.ru/schemas/assets.schema.json",
  "title": "Future Viewer intellectual-property asset registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_at", "assets"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "reviewed_at": { "type": ["string", "null"], "format": "date" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "path_glob", "asset_type", "source_url", "source_revision_or_accessed_at", "author", "license_spdx_or_public_domain_basis", "commercial_use", "attribution_text", "evidence_reference", "sha256_manifest", "shipped", "manual_approved"],
        "properties": {
          "asset_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "path_glob": { "type": "string", "minLength": 1 },
          "asset_type": { "type": "string", "minLength": 1 },
          "source_url": { "type": ["string", "null"] },
          "source_revision_or_accessed_at": { "type": ["string", "null"] },
          "author": { "type": ["string", "null"] },
          "license_spdx_or_public_domain_basis": { "type": ["string", "null"] },
          "commercial_use": { "type": ["boolean", "null"] },
          "attribution_text": { "type": ["string", "null"] },
          "evidence_reference": { "type": ["string", "null"] },
          "sha256_manifest": { "type": ["string", "null"] },
          "shipped": { "type": "boolean" },
          "manual_approved": { "type": "boolean" }
        }
      }
    }
  }
}
