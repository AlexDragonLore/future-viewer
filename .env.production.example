# Copy values into /opt/fv-app/.env.production by running bash init.sh.
# Never commit the real /opt/fv-app/.env.production file.

APP_DOMAIN=alex-taro.ru
FV_COMPOSE_PROJECT_NAME=future-viewer
# Dedicated loopback port used only by the host-level alex-taro.ru edge site.
FV_SHARED_EDGE_PORT=18080

POSTGRES_USER=future_viewer
POSTGRES_PASSWORD=change-me-generate-with-init
POSTGRES_DB=future_viewer

JWT_SECRET=change-me-generate-with-init-at-least-32-chars
JWT_ISSUER=future-viewer
JWT_AUDIENCE=future-viewer
JWT_EXPIRES_MINUTES=259200
PRIVACY_EXPORT_ENABLED=true

AI_PROVIDER=OpenAI
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Leave empty for same-origin production API via Caddy.
VITE_API_URL=
VITE_SITE_URL=https://alex-taro.ru

# Optional search verification. Analytics is disabled until its processor entry
# and the cookie-consent implementation are manually approved.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
VITE_YANDEX_METRICA_ID=

# Public operator/product facts compiled into the frontend. Populate only from
# verified documents; an email is not a postal address.
VITE_MERCHANT_SERVICE_NAME=
VITE_MERCHANT_OWNER_NAME=
VITE_MERCHANT_TAX_STATUS=
VITE_MERCHANT_INN=
VITE_MERCHANT_PHONE=
VITE_MERCHANT_EMAIL=
VITE_MERCHANT_POSTAL_ADDRESS=
VITE_PAID_PRODUCT_TITLE=
VITE_PAID_PRODUCT_PRICE=
VITE_PAID_PRODUCT_PERIOD=
VITE_PAID_PRODUCT_DESCRIPTION=
VITE_NPD_RECEIPT_PROCESS_VERIFIED=false
VITE_NPD_RECEIPT_PROCEDURE=
VITE_SUPPORT_RESPONSE_TERM=
VITE_REFUND_METHOD=
VITE_CLAIM_REVIEW_PROCEDURE=

# Fail-closed legal publication metadata. Keep false/empty until the matching
# machine-readable registries and every published document are manually approved.
VITE_LEGAL_OPERATOR_VERIFIED=false
VITE_LEGAL_PROCESSORS_VERIFIED=false
VITE_LEGAL_PROCESSORS_JSON=
VITE_LEGAL_DOCUMENT_VERSION=
VITE_LEGAL_EFFECTIVE_AT=
VITE_LEGAL_OFFER_VERSION=
VITE_LEGAL_PRIVACY_VERSION=
VITE_LEGAL_PERSONAL_DATA_CONSENT_VERSION=
VITE_LEGAL_MARKETING_CONSENT_VERSION=
VITE_LEGAL_COOKIES_VERSION=
VITE_LEGAL_AI_DISCLAIMER_VERSION=
VITE_LEGAL_DATA_REQUEST_VERSION=
VITE_LEGAL_PROCESSORS_VERSION=
VITE_LEGAL_READING_RETENTION=
VITE_LEGAL_ACCOUNT_RETENTION=
VITE_LEGAL_CONSENT_RETENTION=
VITE_LEGAL_LOG_RETENTION=
VITE_LEGAL_BACKUP_RETENTION=

# For multiple admins, init.sh writes Admin__Emails__0, Admin__Emails__1, ...
Admin__Emails__0=
SUPPORT_EMAIL=


# Production already uses the paid REG.RU mailbox through HTTPS because SMTP
# egress is blocked. Keep its existing credentials; do not reset them on updates.
# Set Smtp only after checking that outbound SMTP and delivery are available.
EMAIL_TRANSPORT=RegruWebmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_SSL=true

# Reverse-proxy trust is empty by default: spoofable X-Forwarded-For is ignored.
# After reviewing every hop, add exact IPs to the backend environment, for example
# ReverseProxy__KnownProxies__0=<verified immediate proxy IP>
# ReverseProxy__KnownProxies__1=<verified preceding proxy IP, only if needed>
# ReverseProxy__ForwardLimit=2
# Never use an entire private network or an arbitrary caller-provided IP.

# Payment provider: Yukassa or YooMoney.
PAYMENT_PROVIDER=Yukassa
PAYMENT_ENABLED=true
PAYMENT_WEBHOOK_ENABLED=true

# YooKassa is optional until paid subscriptions are enabled with YooKassa.
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_CURRENCY=RUB
YUKASSA_MONTHLY_PRICE_AMOUNT=300
YUKASSA_API_BASE_URL=https://api.yookassa.ru/v3/

# YooMoney redirect flow. Receiver is the YooMoney wallet number, not a payout gate id.
YOOMONEY_RECEIVER=
YOOMONEY_NOTIFICATION_SECRET=
YOOMONEY_QUICKPAY_URL=https://yoomoney.ru/quickpay/confirm
YOOMONEY_QUICKPAY_FORM=button
YOOMONEY_PAYMENT_TYPE=AC
YOOMONEY_CURRENCY_CODE=643
YOOMONEY_MONTHLY_PRICE_AMOUNT=300
YOOMONEY_TARGETS="Доступ Future Viewer Pro"
