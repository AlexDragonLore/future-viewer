FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

FROM node:22-alpine AS dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG VITE_API_URL=
ARG VITE_SITE_URL=
ARG VITE_GOOGLE_SITE_VERIFICATION=
ARG VITE_YANDEX_VERIFICATION=
ARG VITE_YANDEX_METRICA_ID=
ARG VITE_MERCHANT_SERVICE_NAME=
ARG VITE_MERCHANT_OWNER_NAME=
ARG VITE_MERCHANT_TAX_STATUS=
ARG VITE_MERCHANT_INN=
ARG VITE_MERCHANT_PHONE=
ARG VITE_MERCHANT_EMAIL=
ARG VITE_MERCHANT_POSTAL_ADDRESS=
ARG VITE_PAID_PRODUCT_TITLE=
ARG VITE_PAID_PRODUCT_PRICE=
ARG VITE_PAID_PRODUCT_PERIOD=
ARG VITE_PAID_PRODUCT_DESCRIPTION=
ARG VITE_NPD_RECEIPT_PROCESS_VERIFIED=false
ARG VITE_NPD_RECEIPT_PROCEDURE=
ARG VITE_SUPPORT_RESPONSE_TERM=
ARG VITE_REFUND_METHOD=
ARG VITE_CLAIM_REVIEW_PROCEDURE=
ARG VITE_LEGAL_OPERATOR_VERIFIED=false
ARG VITE_LEGAL_PROCESSORS_VERIFIED=false
ARG VITE_LEGAL_PROCESSORS_JSON=
ARG VITE_LEGAL_DOCUMENT_VERSION=
ARG VITE_LEGAL_EFFECTIVE_AT=
ARG VITE_LEGAL_OFFER_VERSION=
ARG VITE_LEGAL_PRIVACY_VERSION=
ARG VITE_LEGAL_PERSONAL_DATA_CONSENT_VERSION=
ARG VITE_LEGAL_MARKETING_CONSENT_VERSION=
ARG VITE_LEGAL_COOKIES_VERSION=
ARG VITE_LEGAL_AI_DISCLAIMER_VERSION=
ARG VITE_LEGAL_DATA_REQUEST_VERSION=
ARG VITE_LEGAL_PROCESSORS_VERSION=
ARG VITE_LEGAL_READING_RETENTION=
ARG VITE_LEGAL_ACCOUNT_RETENTION=
ARG VITE_LEGAL_CONSENT_RETENTION=
ARG VITE_LEGAL_LOG_RETENTION=
ARG VITE_LEGAL_BACKUP_RETENTION=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SITE_URL=$VITE_SITE_URL
ENV VITE_GOOGLE_SITE_VERIFICATION=$VITE_GOOGLE_SITE_VERIFICATION
ENV VITE_YANDEX_VERIFICATION=$VITE_YANDEX_VERIFICATION
ENV VITE_YANDEX_METRICA_ID=$VITE_YANDEX_METRICA_ID
ENV VITE_MERCHANT_SERVICE_NAME=$VITE_MERCHANT_SERVICE_NAME
ENV VITE_MERCHANT_OWNER_NAME=$VITE_MERCHANT_OWNER_NAME
ENV VITE_MERCHANT_TAX_STATUS=$VITE_MERCHANT_TAX_STATUS
ENV VITE_MERCHANT_INN=$VITE_MERCHANT_INN
ENV VITE_MERCHANT_PHONE=$VITE_MERCHANT_PHONE
ENV VITE_MERCHANT_EMAIL=$VITE_MERCHANT_EMAIL
ENV VITE_MERCHANT_POSTAL_ADDRESS=$VITE_MERCHANT_POSTAL_ADDRESS
ENV VITE_PAID_PRODUCT_TITLE=$VITE_PAID_PRODUCT_TITLE
ENV VITE_PAID_PRODUCT_PRICE=$VITE_PAID_PRODUCT_PRICE
ENV VITE_PAID_PRODUCT_PERIOD=$VITE_PAID_PRODUCT_PERIOD
ENV VITE_PAID_PRODUCT_DESCRIPTION=$VITE_PAID_PRODUCT_DESCRIPTION
ENV VITE_NPD_RECEIPT_PROCESS_VERIFIED=$VITE_NPD_RECEIPT_PROCESS_VERIFIED
ENV VITE_NPD_RECEIPT_PROCEDURE=$VITE_NPD_RECEIPT_PROCEDURE
ENV VITE_SUPPORT_RESPONSE_TERM=$VITE_SUPPORT_RESPONSE_TERM
ENV VITE_REFUND_METHOD=$VITE_REFUND_METHOD
ENV VITE_CLAIM_REVIEW_PROCEDURE=$VITE_CLAIM_REVIEW_PROCEDURE
ENV VITE_LEGAL_OPERATOR_VERIFIED=$VITE_LEGAL_OPERATOR_VERIFIED
ENV VITE_LEGAL_PROCESSORS_VERIFIED=$VITE_LEGAL_PROCESSORS_VERIFIED
ENV VITE_LEGAL_PROCESSORS_JSON=$VITE_LEGAL_PROCESSORS_JSON
ENV VITE_LEGAL_DOCUMENT_VERSION=$VITE_LEGAL_DOCUMENT_VERSION
ENV VITE_LEGAL_EFFECTIVE_AT=$VITE_LEGAL_EFFECTIVE_AT
ENV VITE_LEGAL_OFFER_VERSION=$VITE_LEGAL_OFFER_VERSION
ENV VITE_LEGAL_PRIVACY_VERSION=$VITE_LEGAL_PRIVACY_VERSION
ENV VITE_LEGAL_PERSONAL_DATA_CONSENT_VERSION=$VITE_LEGAL_PERSONAL_DATA_CONSENT_VERSION
ENV VITE_LEGAL_MARKETING_CONSENT_VERSION=$VITE_LEGAL_MARKETING_CONSENT_VERSION
ENV VITE_LEGAL_COOKIES_VERSION=$VITE_LEGAL_COOKIES_VERSION
ENV VITE_LEGAL_AI_DISCLAIMER_VERSION=$VITE_LEGAL_AI_DISCLAIMER_VERSION
ENV VITE_LEGAL_DATA_REQUEST_VERSION=$VITE_LEGAL_DATA_REQUEST_VERSION
ENV VITE_LEGAL_PROCESSORS_VERSION=$VITE_LEGAL_PROCESSORS_VERSION
ENV VITE_LEGAL_READING_RETENTION=$VITE_LEGAL_READING_RETENTION
ENV VITE_LEGAL_ACCOUNT_RETENTION=$VITE_LEGAL_ACCOUNT_RETENTION
ENV VITE_LEGAL_CONSENT_RETENTION=$VITE_LEGAL_CONSENT_RETENTION
ENV VITE_LEGAL_LOG_RETENTION=$VITE_LEGAL_LOG_RETENTION
ENV VITE_LEGAL_BACKUP_RETENTION=$VITE_LEGAL_BACKUP_RETENTION
RUN npm run build

FROM nginx:1.27-alpine AS prod
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
